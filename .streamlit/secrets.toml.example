# Copia este archivo como `secrets.toml` (en la misma carpeta .streamlit/)
# y pega tu API key de Gemini. NUNCA subas secrets.toml a GitHub.
#
# Como obtener la key:
#   1. Entra a https://aistudio.google.com/apikey
#   2. Inicia sesion con tu cuenta de Google
#   3. "Create API key" -> copia el valor
#
# El archivo secrets.toml real esta ignorado en .gitignore.

GEMINI_API_KEY = "pega-tu-api-key-aqui"
